{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Google Managed Service for Prometheus",
  "id": "binboum-googleprometheus-datasource",
  "category": "tsdb",
  "metrics": true,
  "alerting": true,
  "annotations": true,
  "backend": true,
  "executable": "gpx_googleprometheus",
  "info": {
    "description": "Query Google Managed Service for Prometheus metrics in Grafana with native Google Cloud authentication",
    "author": {
      "name": "Maxence Laude"
    },
    "keywords": [
      "prometheus",
      "google",
      "gcp",
      "gmp",
      "managed-prometheus"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Source code",
        "url": "https://github.com/binboum/binboum-googleprometheus-datasource"
      },
      {
        "name": "License",
        "url": "https://github.com/binboum/binboum-googleprometheus-datasource/blob/main/LICENSE"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/binboum/binboum-googleprometheus-datasource/blob/main/README.md"
      }
    ],
    "screenshots": [
      {
        "name": "Google Cloud authentication on the data source config page",
        "path": "img/screenshots/config-google-auth.png"
      },
      {
        "name": "Querying a Prometheus endpoint through the data source in Explore",
        "path": "img/screenshots/explore-query.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "routes": [
    {
      "method": "POST",
      "path": "api/v1/query",
      "reqRole": "Viewer"
    },
    {
      "method": "POST",
      "path": "api/v1/query_range",
      "reqRole": "Viewer"
    },
    {
      "method": "POST",
      "path": "api/v1/series",
      "reqRole": "Viewer"
    },
    {
      "method": "POST",
      "path": "api/v1/labels",
      "reqRole": "Viewer"
    },
    {
      "method": "POST",
      "path": "api/v1/query_exemplars",
      "reqRole": "Viewer"
    },
    {
      "method": "GET",
      "path": "/rules",
      "reqRole": "Viewer"
    },
    {
      "method": "POST",
      "path": "/rules",
      "reqRole": "Editor"
    },
    {
      "method": "DELETE",
      "path": "/rules",
      "reqRole": "Editor"
    },
    {
      "method": "GET",
      "path": "/api/v1/rules",
      "reqRole": "Viewer"
    },
    {
      "method": "GET",
      "path": "/api/v1/alerts",
      "reqRole": "Viewer"
    },
    {
      "method": "GET",
      "path": "/api/v1/metadata",
      "reqRole": "Viewer"
    },
    {
      "method": "GET",
      "path": "/api/v1/status/buildinfo",
      "reqRole": "Viewer"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.5.0",
    "plugins": []
  }
}
