{
  "ignorePaths": [
    ".config/**",
    ".github/**",
    ".vscode/**",
    "coverage/**",
    "cspell.config.json",
    "e2e/**",
    "playwright/**",
    "dist/**",
    "docker-compose*.yaml",
    "docker-compose*.yml",
    "go.sum",
    "mage_output_file.go",
    "node_modules/**",
    "package.json",
    "pkg/**/*_test.go",
    "pkg/**/*.html",
    "pkg/**/*.json",
    "pkg/**/*.jsonc",
    "pkg/testdata/**",
    "prometheus/**",
    "provisioning/**",
    "yarn.lock"
  ],
  "ignoreRegExpList": ["import\\s*\\((.|[\r\n])*?\\)", "import\\s*.*\".*?\""],
  "words": [
    "grafana",
    "datasource",
    "datasources",
    "googleprometheus",
    "googleauth",
    "binboum",
    "Stackdriver",
    "GitOps",
    "tokenprovider",
    "tsdb",
    "promlib",
    "promql",
    "instancemgmt",
    "plog",
    "sdkhttpclient",
    "buildinfo",
    "syncer",
    "gpx",
    "Magefile",
    "levitate",
    "corepack",
    "renovate",
    "templating",
    "stretchr",
    "approvedGitRepositories",
    "checksumBehavior",
    "codeowners",
    "defaultSemverRangePrefix",
    "nmHoistingLimits",
    "unsafeHttpWhitelist",
    "yarnrc"
  ]
}
