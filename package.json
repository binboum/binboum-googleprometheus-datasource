{
  "name": "binboum-googleprometheus-datasource",
  "version": "0.1.0",
  "description": "Query Google Managed Service for Prometheus metrics in Grafana with native Google Cloud authentication",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binboum/binboum-googleprometheus-datasource.git"
  },
  "homepage": "https://github.com/binboum/binboum-googleprometheus-datasource#readme",
  "bugs": "https://github.com/binboum/binboum-googleprometheus-datasource/issues",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "yarn run lint --fix && prettier --write --list-different .",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "levitate:is-compatible": "levitate is-compatible --path src/module.ts --target @grafana/data,@grafana/ui,@grafana/runtime",
    "sign": "sign-plugin",
    "server": "docker compose up --build"
  },
  "author": "Maxence Laude",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@emotion/eslint-plugin": "11.12.0",
    "@eslint/compat": "2.0.5",
    "@grafana/e2e-selectors": "12.4.2",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/levitate": "0.17.2",
    "@grafana/plugin-e2e": "3.4.12",
    "@grafana/sign-plugin": "3.2.2",
    "@grafana/tsconfig": "2.0.1",
    "@playwright/test": "1.59.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.24",
    "@swc/helpers": "0.5.21",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/eslint": "9.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.0.0",
    "css-loader": "7.1.4",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-deprecation": "3.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "prettier": "3.8.2",
    "react-select-event": "5.5.1",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.99.0",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.4.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "webpack": "5.106.0",
    "webpack-cli": "7.0.2",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "6.0.1",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.4.2",
    "@grafana/plugin-ui": "^0.13.1",
    "@grafana/prometheus": "13.1.4",
    "@grafana/runtime": "12.4.2",
    "@grafana/schema": "12.4.2",
    "@grafana/ui": "12.4.2",
    "@openfeature/core": "^1.9.2",
    "@openfeature/web-sdk": "^1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.14.0"
}
